# QWeather API Configuration
# ==========================
# This file contains sensitive info, DO NOT commit to Git
# Copy this file to .env and fill in your values

# 【REQUIRED】API Key
# Get from: https://dev.qweather.com/
# Format: 32-character lowercase hex string (e.g., 435f252109884ccfb9e71e8d23f8ef6c)
QWEATHER_API_KEY=your_api_key_here

# 【REQUIRED】API Host
# Your API Host depends on your subscription and region
# Check your project dashboard at https://dev.qweather.com/
#
# Common hosts:
#   - devapi.qweather.com         (Commercial/Enterprise)
#   - api.qweather.com             (Free tier)
#   - na4jabtn5w.re.qweatherapi.com (Regional/Custom)
#   - xxx.qweatherapi.com          (Your custom host from project dashboard)
QWEATHER_API_HOST=your_api_host_here

# 【OPTIONAL】Usage Logging
# Set to "true" to enable local usage tracking (logs to usage-log.jsonl)
# Default: false (disabled)
QWEATHER_LOG_USAGE=false

# 【OPTIONAL】Hide Billing Notice
# Set to "true" to hide billing reminder before typhoon queries
# Default: false (show notice)
QWEATHER_SHOW_BILLING_NOTICE=false
